+// Defer one library's static initialisers until the runtime has prepared the
+// Android services they call. The flag is consumed by the next do_dlopen().
+static bool g_defer_next_ctors = false;
+
+soinfo* soinfo_from_handle(void* handle);
+
+extern "C" void mcpelauncher_defer_next_ctors(int defer) {
+  g_defer_next_ctors = defer != 0;
+}
+
+extern "C" void mcpelauncher_run_deferred_ctors(void* handle) {
+  soinfo* si = soinfo_from_handle(handle);
+  if (si != nullptr) {
+    si->call_constructors();
+  }
+}
